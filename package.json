{
  "name": "scrap-car-runner",
  "version": "0.1.0",
  "description": "Junkyard engineering auto-driver progression game",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "simulate": "node --import tsx/esm tools/simulate.ts",
    "validate:data": "node --import tsx/esm tools/validate-data.ts",
    "validate:assets": "node --import tsx/esm tools/assets/validateAssets.ts",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "check": "npm run typecheck && npm run typecheck:tools && npm run test && npm run validate:data && npm run validate:assets && npm run simulate && npm run build"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=10.0.0"
  }
}
