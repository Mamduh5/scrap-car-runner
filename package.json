{
  "name": "scrap-car-runner",
  "version": "0.1.0",
  "description": "Junkyard engineering auto-driver progression game",
  "private": true,
  "type": "module",
  "scripts": {
    "dev":           "vite",
    "build":         "tsc -p tsconfig.build.json --noEmit && vite build",
    "preview":       "vite preview",
    "typecheck":     "tsc --noEmit",
    "test":          "vitest run",
    "test:watch":    "vitest",
    "test:coverage": "vitest run --coverage",
    "simulate":      "node tools/sim-check.js",
    "validate:data": "node --import tsx/esm tools/validate-data.ts"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "tsx":                 "^4.19.3",
    "typescript":          "^5.8.3",
    "vite":                "^8.3.2",
    "vitest":              "^5.0.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm":  ">=10.0.0"
  }
}
